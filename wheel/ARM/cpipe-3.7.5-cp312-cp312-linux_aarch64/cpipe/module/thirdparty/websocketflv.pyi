import av
import io
import numpy as np
import threading
import websocket
from _typeshed import Incomplete

class WSBuffer(io.RawIOBase):
    _buf: Incomplete
    _cv: Incomplete
    _eof: bool
    def __init__(self) -> None: ...
    def readable(self): ...
    def read(self, n: int = -1): ...
    def feed(self, data: bytes): ...
    def close(self): ...

class WSFLVVideoCapture:
    """基于 WebSocket FLV 拉流的 VideoCapture 兼容实现。

    提供与 cv2.VideoCapture 类似的接口：
    - isOpened()
    - get(prop)
    - read() -> (ret, frame[BGR uint8])
    - grab() -> 仅前进丢帧（不做 BGR 转换）
    - release()
    """
    _ws_url: Incomplete
    _open_timeout_sec: Incomplete
    _idle_timeout_sec: Incomplete
    _ws_buf: WSBuffer | None
    _stop_event: threading.Event | None
    _ws_thread: threading.Thread | None
    _wsapp: websocket.WebSocketApp | None
    _container: av.container.InputContainer | None
    _video_stream: av.video.stream.VideoStream | None
    _is_opened: bool
    _decode_lock: Incomplete
    _last_data_ts: float
    def __init__(self, ws_url: str | None = None, open_timeout_sec: float = 10.0, idle_timeout_sec: float = 5.0) -> None: ...
    def _run_ws(self) -> None: ...
    def open(self, ws_url: str) -> bool: ...
    def release(self) -> None: ...
    def isOpened(self) -> bool: ...
    def _compute_fourcc(self) -> int: ...
    def get(self, prop_id: int) -> float: ...
    def _next_decoded_frame(self) -> av.VideoFrame | None: ...
    def read(self, data: np.ndarray | None = None) -> tuple[bool, np.ndarray | None]: ...
    def grab(self) -> bool: ...
