import types
from _typeshed import Incomplete

__all__ = ['DatasetRecorder', 'Dataset', 'ListDataset', 'TensorBatchDataset']

class DatasetRecorder:
    dataset: Incomplete
    module: Incomplete
    handle: Incomplete
    def __init__(self, dataset, module) -> None: ...
    def __enter__(self, *args, **kwargs): ...
    def __exit__(self, *args, **kwargs) -> None: ...
    def _callback(self, module, input) -> None: ...

class Dataset:
    def __len__(self) -> int: ...
    def __getitem__(self, index) -> None: ...
    def insert(self, item) -> None: ...
    def record(self, module): ...
    def num_inputs(self): ...
    _flattener: Incomplete
    @property
    def flattener(self): ...
    def getitem_flat(self, index): ...
    def shapes_for_index(self, index, flat: bool = False): ...
    def shapes(self, flat: bool = False): ...
    def _shape_stats(self, stat_fn, flat: bool = False): ...
    def min_shapes(self, flat: bool = False): ...
    def max_shapes(self, flat: bool = False): ...
    def item_numel(self, index): ...
    def median_numel_shapes(self, flat: bool = False): ...
    def infer_dynamic_axes(self, flat: bool = False): ...

class ListDataset(Dataset):
    items: Incomplete
    def __init__(self, items=None) -> None: ...
    def __len__(self) -> int: ...
    def __getitem__(self, index): ...
    def insert(self, item) -> None: ...

class TensorBatchDataset(Dataset):
    _flattener: Incomplete
    tensors: Incomplete
    def __init__(self, tensors=None) -> None: ...
    def __len__(self) -> int: ...
    def __getitem__(self, idx): ...
    def insert(self, tensors) -> None: ...

class FolderDataset(Dataset):
    folder: Incomplete
    def __init__(self, folder) -> None: ...
    def file_paths(self): ...
    def __len__(self) -> int: ...
    def __getitem__(self, index): ...
    def insert(self, tensors) -> None: ...
